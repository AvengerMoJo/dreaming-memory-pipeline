{
  "modules": [
    {
      "name": "mojo_memory",
      "version": "1.0.0",
      "contract_version": "1.0",
      "provider_type": "memory",
      "entry_point": "mojo_memory.services.memory_provider.MemoryProviderAdapter",
      "description": "Memory provider — conversation CRUD/search, knowledge units, archival",
      "capabilities": {
        "supports_embeddings": true,
        "supports_archive": true,
        "supports_conversation_search": true,
        "retrieval_strategies": ["semantic", "hybrid"],
        "default_retrieval_strategy": "hybrid"
      },
      "dependencies": [],
      "data_contracts": {
        "ConversationStore": "1.0"
      }
    },
    {
      "name": "mojo_dream",
      "version": "1.0.0",
      "contract_version": "1.0",
      "provider_type": "dream",
      "entry_point": "dreaming.dream_provider.DreamProviderAdapter",
      "description": "Dream provider — ABCD pipeline, inbox distillation, session compaction",
      "capabilities": {
        "supports_abcd_pipeline": true,
        "supports_inbox_distillation": true,
        "supports_session_compaction": true
      },
      "dependencies": ["mojo_memory"],
      "data_contracts": {
        "DreamArchive": "1.0",
        "TaskSession": "1.0"
      }
    }
  ]
}
